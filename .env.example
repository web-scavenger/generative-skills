# Copy to .env (gitignored) and fill in your keys.
# Export into your shell before launching the agent:
#   set -a; source .env; set +a
# The committed .mcp.json expands these via ${VAR} in its auth headers.

# OpenRouter API key — https://openrouter.ai/keys
# Used by .mcp.json as: Authorization: Bearer ${OPEN_ROUTER_AUTH_TOKEN}
OPEN_ROUTER_AUTH_TOKEN=

# fal.ai API key — https://fal.ai/dashboard/keys
# Used by .mcp.json as: Bearer ${FAL_KEY} for fal generation; Key ${FAL_KEY} for optional fal-platform.
FAL_KEY=
