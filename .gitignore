# Generated media — large binaries, kept out of git.
# The meta.json sidecars and folder structure stay tracked (see outputs/README.md).
outputs/**/*.png
outputs/**/*.jpg
outputs/**/*.jpeg
outputs/**/*.webp
outputs/**/*.gif
outputs/**/*.mp4
outputs/**/*.mov
outputs/**/*.webm
outputs/**/*.mp3
outputs/**/*.wav

# Ignore machine-local tool state (settings, permissions), but keep the
# committed skills-discovery wiring so a clone gets both agents set up.
.claude/*
!.claude/skills
.codex/*
!.codex/skills

# Local price cache — regenerable live-query results, time/machine-specific.
# Stale prices in git would be worse than no cache, so keep it out.
price-cache.json

# Creative front-end: track the text artifacts (briefs/scripts/storyboards +
# sidecars) and learned style profiles, but keep the user's own source material
# and reference assets — and any media generated under content/ — out of git.
channels/**/examples/**
!channels/**/examples/.gitkeep
channels/**/references/**
!channels/**/references/.gitkeep
content/**/*.png
content/**/*.jpg
content/**/*.jpeg
content/**/*.webp
content/**/*.gif
content/**/*.mp4
content/**/*.mov
content/**/*.webm
content/**/*.mp3
content/**/*.wav
content/*

# OS / editor cruft
.DS_Store
.env
